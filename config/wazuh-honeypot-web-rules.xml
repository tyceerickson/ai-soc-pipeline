<!-- ============================================================
     Custom Wazuh Rules — Dionaea (malware) + nginx (web) Honeypots
     File: /var/ossec/etc/rules/wazuh-honeypot-web-rules.xml
     Rule IDs: 100200-100399
     Project 4: AI-Powered SOC Pipeline · CMU MSISPM Portfolio

     REBUILD (v3) — MITRE-accurate, single-technique-per-behaviour, and
     CORRECTED eventid matching.

     IMPORTANT FIX: the live Dionaea eventids end in the daemon name with a
     trailing 'd' — dionaea.connection.smbd / .mysqld / .mssqld and
     dionaea.login.mysqld / .mssqld — NOT the .smb/.mysql/.mssql the earlier
     rules matched. Those earlier rules silently never fired. This version
     matches the real eventids (verified against 30-day captured data).

     Cowrie SSH/Telnet rules live in wazuh-cowrie-rules.xml (100100-100199).

     Deploy:
       sudo cp wazuh-honeypot-web-rules.xml /var/ossec/etc/rules/
       sudo chown wazuh:wazuh /var/ossec/etc/rules/wazuh-honeypot-web-rules.xml
       sudo /var/ossec/bin/wazuh-analysisd -t
       sudo systemctl restart wazuh-manager
     ============================================================ -->

<!-- ============================================================
     DIONAEA MALWARE-CAPTURE HONEYPOT   (100200-100269)
     Observed eventids: connection.{smbd,mysqld,mssqld},
                        login.{mysqld,mssqld}, binary.captured
     ============================================================ -->
<group name="dionaea,honeypot,malware,">

  <rule id="100200" level="0">
    <decoded_as>json</decoded_as>
    <field name="data.honeypot">dionaea</field>
    <description>Dionaea honeypot event (base)</description>
    <group>honeypot,dionaea,</group>
  </rule>

  <!-- ===== Service connections ===== -->

  <rule id="100210" level="5">
    <if_sid>100200</if_sid>
    <field name="data.eventid">dionaea.connection.smbd</field>
    <description>Dionaea: SMB service probe from $(data.src_ip) — wormable/lateral vector</description>
    <mitre><id>T1021.002</id></mitre>
    <group>honeypot,dionaea,connection,smb,lateral_movement,</group>
  </rule>

  <rule id="100211" level="5">
    <if_sid>100200</if_sid>
    <field name="data.eventid">dionaea.connection.mysqld</field>
    <description>Dionaea: MySQL service probe from $(data.src_ip)</description>
    <mitre><id>T1190</id></mitre>
    <group>honeypot,dionaea,connection,mysql,</group>
  </rule>

  <rule id="100212" level="5">
    <if_sid>100200</if_sid>
    <field name="data.eventid">dionaea.connection.mssqld</field>
    <description>Dionaea: MSSQL service probe from $(data.src_ip)</description>
    <mitre><id>T1190</id></mitre>
    <group>honeypot,dionaea,connection,mssql,</group>
  </rule>

  <!-- Generic catch for other dionaea.connection.* (ftp, http, sip, etc.) -->
  <rule id="100213" level="4">
    <if_sid>100200</if_sid>
    <field name="data.eventid" type="pcre2">^dionaea\.connection\.</field>
    <description>Dionaea: Service probe from $(data.src_ip)</description>
    <mitre><id>T1046</id></mitre>
    <group>honeypot,dionaea,connection,</group>
  </rule>

  <!-- ===== DB authentication ===== -->

  <rule id="100220" level="7">
    <if_sid>100200</if_sid>
    <field name="data.eventid">dionaea.login.mysqld</field>
    <description>Dionaea: MySQL authentication attempt from $(data.src_ip)</description>
    <mitre><id>T1110</id></mitre>
    <group>honeypot,dionaea,authentication_failed,mysql,</group>
  </rule>

  <rule id="100221" level="7">
    <if_sid>100200</if_sid>
    <field name="data.eventid">dionaea.login.mssqld</field>
    <description>Dionaea: MSSQL authentication attempt from $(data.src_ip)</description>
    <mitre><id>T1110</id></mitre>
    <group>honeypot,dionaea,authentication_failed,mssql,</group>
  </rule>

  <rule id="100222" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100220</if_matched_sid>
    <same_field>data.src_ip</same_field>
    <description>Dionaea: Database brute force — 5+ DB auth attempts/120s from $(data.src_ip)</description>
    <mitre><id>T1110</id></mitre>
    <group>honeypot,dionaea,brute_force,</group>
  </rule>

  <!-- ===== Malware capture ===== -->

  <rule id="100230" level="14">
    <if_sid>100200</if_sid>
    <field name="data.eventid">dionaea.binary.captured</field>
    <description>Dionaea: Malware binary captured from $(data.src_ip) — SHA256=$(data.sha256)</description>
    <mitre><id>T1105</id></mitre>
    <group>honeypot,dionaea,malware,binary,</group>
  </rule>

  <rule id="100231" level="15" frequency="3" timeframe="600">
    <if_matched_sid>100230</if_matched_sid>
    <same_field>data.src_ip</same_field>
    <description>Dionaea: Active malware distributor — multiple binaries from $(data.src_ip)</description>
    <mitre><id>T1105</id></mitre>
    <group>honeypot,dionaea,malware,distributor,</group>
  </rule>

</group>

<!-- ============================================================
     NGINX WEB HONEYPOT   (100300-100399)
     Observed eventids: probe.{404,env_file,router,git,hikvision,wordpress,
                        tomcat}, request.{success,bad}
     ============================================================ -->
<group name="nginx,honeypot,web,">

  <rule id="100300" level="0">
    <decoded_as>json</decoded_as>
    <field name="data.honeypot">nginx</field>
    <description>nginx web honeypot event (base)</description>
    <group>honeypot,nginx,</group>
  </rule>

  <rule id="100301" level="3">
    <if_sid>100300</if_sid>
    <field name="data.eventid">nginx.probe.404</field>
    <description>nginx: Web probe (404) from $(data.src_ip) — $(data.http_path)</description>
    <mitre><id>T1595.003</id></mitre>
    <group>honeypot,nginx,recon,</group>
  </rule>

  <!-- ===== CVE / exploit-path probes ===== -->

  <rule id="100310" level="9">
    <if_sid>100300</if_sid>
    <field name="data.eventid">nginx.probe.env_file</field>
    <description>nginx: .env credential-theft probe from $(data.src_ip)</description>
    <mitre><id>T1552.001</id></mitre>
    <group>honeypot,nginx,credential_access,cve,</group>
  </rule>

  <rule id="100311" level="8">
    <if_sid>100300</if_sid>
    <field name="data.eventid">nginx.probe.git</field>
    <description>nginx: .git repository exposure probe from $(data.src_ip)</description>
    <mitre><id>T1213</id></mitre>
    <group>honeypot,nginx,recon,cve,</group>
  </rule>

  <rule id="100312" level="6">
    <if_sid>100300</if_sid>
    <field name="data.eventid">nginx.probe.wordpress</field>
    <description>nginx: WordPress vulnerability probe from $(data.src_ip)</description>
    <mitre><id>T1190</id></mitre>
    <group>honeypot,nginx,initial_access,cve,</group>
  </rule>

  <rule id="100313" level="7">
    <if_sid>100300</if_sid>
    <field name="data.eventid">nginx.probe.tomcat</field>
    <description>nginx: Tomcat manager probe from $(data.src_ip)</description>
    <mitre><id>T1190</id></mitre>
    <group>honeypot,nginx,initial_access,cve,</group>
  </rule>

  <rule id="100314" level="7">
    <if_sid>100300</if_sid>
    <field name="data.eventid">nginx.probe.router</field>
    <description>nginx: Router/IoT firmware exploit probe from $(data.src_ip)</description>
    <mitre><id>T1190</id></mitre>
    <group>honeypot,nginx,iot,initial_access,cve,</group>
  </rule>

  <rule id="100315" level="9">
    <if_sid>100300</if_sid>
    <field name="data.eventid">nginx.probe.hikvision</field>
    <description>nginx: Hikvision RCE probe (CVE-2021-36260) from $(data.src_ip)</description>
    <mitre><id>T1190</id></mitre>
    <group>honeypot,nginx,cve,initial_access,</group>
  </rule>

  <rule id="100316" level="13">
    <if_sid>100300</if_sid>
    <field name="data.eventid">nginx.probe.log4shell</field>
    <description>nginx: Log4Shell (CVE-2021-44228) probe from $(data.src_ip)</description>
    <mitre><id>T1190</id><id>T1059</id></mitre>
    <group>honeypot,nginx,cve,log4shell,initial_access,</group>
  </rule>

  <!-- ===== Request outcomes ===== -->

  <rule id="100320" level="3">
    <if_sid>100300</if_sid>
    <field name="data.eventid">nginx.request.success</field>
    <description>nginx: Scanner completed request from $(data.src_ip) [$(data.scanner_type)]</description>
    <mitre><id>T1595.003</id></mitre>
    <group>honeypot,nginx,recon,</group>
  </rule>

  <rule id="100321" level="3">
    <if_sid>100300</if_sid>
    <field name="data.eventid">nginx.request.bad</field>
    <description>nginx: Malformed/binary request from $(data.src_ip)</description>
    <group>honeypot,nginx,</group>
  </rule>

  <!-- ===== Correlation ===== -->

  <rule id="100330" level="9" frequency="20" timeframe="60">
    <if_matched_sid>100301</if_matched_sid>
    <same_field>data.src_ip</same_field>
    <description>nginx: Automated web scanner — 20+ probes/60s from $(data.src_ip)</description>
    <mitre><id>T1595.003</id></mitre>
    <group>honeypot,nginx,scanner,automated,</group>
  </rule>

  <rule id="100332" level="11" frequency="3" timeframe="300">
    <if_matched_group>cve</if_matched_group>
    <same_field>data.src_ip</same_field>
    <description>nginx: Multi-CVE scanner — $(data.src_ip) probing multiple vulnerability classes</description>
    <mitre><id>T1595.003</id></mitre>
    <group>honeypot,nginx,scanner,multi_cve,</group>
  </rule>

  <!-- ===== Scanner-identity rules (parser scanner_type fall-through) ===== -->

  <rule id="100340" level="6">
    <if_sid>100300</if_sid>
    <field name="data.scanner_type">Spoofed Browser</field>
    <description>nginx: Spoofed-browser scanner from $(data.src_ip) — fake browser UA, $(data.http_path)</description>
    <mitre><id>T1595.003</id><id>T1036</id></mitre>
    <group>honeypot,nginx,scanner,spoofed_browser,defense_evasion,</group>
  </rule>

  <rule id="100341" level="5">
    <if_sid>100300</if_sid>
    <field name="data.scanner_type">No User-Agent</field>
    <description>nginx: Request with no User-Agent from $(data.src_ip) — automated client</description>
    <mitre><id>T1595.003</id></mitre>
    <group>honeypot,nginx,scanner,no_user_agent,</group>
  </rule>

  <rule id="100342" level="5">
    <if_sid>100300</if_sid>
    <field name="data.scanner_type">HTTP Library</field>
    <description>nginx: Scripted HTTP-library client from $(data.src_ip) — $(data.http_path)</description>
    <mitre><id>T1595.003</id></mitre>
    <group>honeypot,nginx,scanner,http_library,</group>
  </rule>

  <rule id="100343" level="4">
    <if_sid>100300</if_sid>
    <field name="data.scanner_type">Other Automated</field>
    <description>nginx: Unrecognised automated client from $(data.src_ip) — $(data.http_path)</description>
    <mitre><id>T1595.003</id></mitre>
    <group>honeypot,nginx,scanner,other_automated,</group>
  </rule>

  <rule id="100344" level="9" frequency="15" timeframe="60">
    <if_matched_sid>100340</if_matched_sid>
    <same_field>data.src_ip</same_field>
    <description>nginx: Evasive scan campaign — 15+ spoofed-browser probes/60s from $(data.src_ip)</description>
    <mitre><id>T1595.003</id><id>T1036</id></mitre>
    <group>honeypot,nginx,scanner,spoofed_browser,automated,</group>
  </rule>

</group>
